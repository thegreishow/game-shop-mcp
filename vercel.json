{
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/(.*)", "destination": "/api/mcp" },
    { "source": "/oauth/authorize", "destination": "/api/oauth?route=authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth?route=token" },
    { "source": "/oauth/status", "destination": "/api/oauth?route=status" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?route=metadata" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?route=metadata&kind=protected" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/oauth?route=metadata&kind=protected" },
    { "source": "/api/autonomy-sweep", "destination": "/api/worker?action=autonomy" },
    { "source": "/api/reconcile", "destination": "/api/worker?action=reconcile" },
    { "source": "/qa/evidence", "destination": "/api/evidence" }
  ],
  "functions": {
    "api/mcp.ts": { "maxDuration": 60 },
    "api/server.ts": { "maxDuration": 60 }
  }
}
