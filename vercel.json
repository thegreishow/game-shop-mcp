{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "release-*": true,
      "gameshop/release-*": true,
      "**": false
    }
  },
  "rewrites": [
    { "source": "/console", "destination": "/index.html" },
    { "source": "/console/", "destination": "/index.html" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/(.*)", "destination": "/api/mcp" },
    { "source": "/oauth/authorize", "destination": "/api/oauth?route=authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth?route=token" },
    { "source": "/oauth/register", "destination": "/api/oauth?route=register" },
    { "source": "/oauth/status", "destination": "/api/oauth?route=status" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?route=metadata" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?route=metadata&kind=protected" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/oauth?route=metadata&kind=protected" },
    { "source": "/.well-known/openai-apps-challenge", "destination": "/api/utility?route=openai-apps-challenge" },
    { "source": "/privacy", "destination": "/api/utility?route=privacy" },
    { "source": "/terms", "destination": "/api/utility?route=terms" },
    { "source": "/api/privacy", "destination": "/api/utility?route=privacy" },
    { "source": "/api/terms", "destination": "/api/utility?route=terms" },
    { "source": "/api/autonomy-sweep", "destination": "/api/worker?action=autonomy" },
    { "source": "/api/reconcile", "destination": "/api/worker?action=reconcile" },
    { "source": "/api/diagnostics", "destination": "/api/utility?route=diagnostics" },
    { "source": "/api/storage", "destination": "/api/utility?route=storage" },
    { "source": "/api/tasks", "destination": "/api/utility?route=tasks" },
    { "source": "/qa/evidence", "destination": "/api/evidence" }
  ],
  "headers": [
    {
      "source": "/console",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "functions": {
    "api/mcp.ts": { "maxDuration": 60 },
    "api/server.ts": { "maxDuration": 60 }
  }
}
