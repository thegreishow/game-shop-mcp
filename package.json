{
  "name": "game-shop-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:mcp": "tsx scripts/smoke.ts",
    "test:oauth": "tsx scripts/oauth-smoke.ts",
    "test:security": "tsx scripts/security-adversarial.ts",
    "verify:oauth-live": "tsx scripts/verify-oauth-live.ts",
    "verify:oauth-runtime-live": "tsx scripts/oauth-live-smoke.ts",
    "setup:preline": "bash scripts/setup-preline.sh",
    "setup:sdk-hub": "bash scripts/setup-sdk-hub.sh",
    "setup:playwright": "playwright install chromium",
    "playwright:mcp": "npx --yes @playwright/mcp@0.0.80 --headless --caps=network,testing,devtools --port 8931",
    "playwright:cli": "npx --yes @playwright/cli@0.1.19",
    "test:playwright-lane": "tsx scripts/playwright-lane-smoke.ts",
    "test:sdk-hub": "tsx scripts/sdk-hub-smoke.ts",
    "test:provider-health": "tsx scripts/provider-health-smoke.ts",
    "test:orchestration-v3": "tsx scripts/real-orchestration-phase3-smoke.ts",
    "test:web-game-capabilities": "tsx scripts/web-game-capabilities-smoke.ts",
    "test:game-workflow": "tsx scripts/game-workflow-router-smoke.ts",
    "test:website-workflow": "tsx scripts/website-workflow-router-smoke.ts",
    "test:mission-control": "tsx scripts/mission-control-smoke.ts",
    "test:mission-auth-e2e": "tsx scripts/mission-control-auth-e2e.ts",
    "test:web-console": "node --check console.js && node --check console-mission.js && tsx scripts/web-console-smoke.ts",
    "snapshot:ecosystem": "tsx scripts/generate-ecosystem-snapshot.ts",
    "handoff:llm": "bash scripts/export-llm-handoff.sh",
    "bootstrap:universal": "bash scripts/bootstrap-universal-llm.sh",
    "verify:standalone": "npm run typecheck && npm run test:sdk-hub && npm run test:provider-health && npm run test:orchestration-v3 && npm run test:web-game-capabilities && npm run test:game-workflow && npm run test:website-workflow && npm run test:mission-control && npm run test:mission-auth-e2e && npm run test:web-console && npm run test:playwright-lane && npm run snapshot:ecosystem",
    "test": "npm run typecheck && npm run test:mcp && npm run test:oauth && npm run test:security && npm run test:orchestration-v3 && npm run test:web-game-capabilities && npm run test:game-workflow && npm run test:website-workflow && npm run test:mission-control && npm run test:mission-auth-e2e && npm run test:web-console && npm run test:playwright-lane"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@fal-ai/client": "^1.10.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@podium-sdk/node-sdk": "^0.5.0",
    "@scenario-labs/sdk": "^3.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "animejs": "^4.5.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "igdb-api-node": "^6.0.5",
    "mcp-handler": "^2.1.1",
    "openai": "^7.15.0",
    "preline": "^3.2.3",
    "replicate": "^1.4.0",
    "stripe": "^22.6.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/cli": "^0.1.19",
    "@playwright/mcp": "^0.0.80",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.8",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vercel": "^48.0.0"
  }
}
