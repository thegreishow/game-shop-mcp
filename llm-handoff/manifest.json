{
  "schemaVersion": 2,
  "project": "game-shop-mcp",
  "architecture": {
    "principle": "Game Shop orchestrates providers plus dedicated game and website workflow specialists while direct provider MCP/API/SDK access remains possible.",
    "layers": ["mcp", "web-console", "sdk", "api", "cli", "library", "local-runtime", "artifact-lifecycle", "game-workflow-routing", "website-workflow-routing", "orchestration"],
    "secretPolicy": "Never commit provider secret values. Keep names/contracts in git and values in local/deployment secret stores.",
    "paidGenerationDefault": "blocked",
    "paidGenerationOptInEnv": "GAME_SHOP_ALLOW_PAID_GENERATION",
    "fallbackPolicy": "route-before-submit only; never auto-resubmit an ambiguous paid generation to another provider"
  },
  "canonicalFiles": [
    "AGENTS.md",
    "ecosystem.json",
    "mcp.json",
    "index.html",
    "console.js",
    "console.css",
    "llm-handoff/agent-config.json",
    "docs/GAME_WORKFLOW_ORCHESTRATION.md",
    "docs/WEBSITE_WORKFLOW_ORCHESTRATION.md",
    "docs/WEB_CONSOLE.md",
    "docs/STANDALONE_PORTABILITY.md",
    "docs/SDK_HUB.md",
    "docs/REAL_ORCHESTRATION.md",
    "src/game-workflow-router.ts",
    "src/register-game-workflow-tools.ts",
    "src/website-workflow-router.ts",
    "src/register-website-workflow-tools.ts",
    "src/integrations.ts",
    "src/sdk-hub.ts",
    "src/provider-adapters-v2.ts",
    "src/provider-health-v2.ts",
    "src/normalized-output.ts",
    "src/real-orchestration.ts",
    "src/orchestrator.ts",
    "src/spend.ts",
    "src/security.ts",
    "schemas/artifact.schema.json",
    ".env.example"
  ],
  "webConsole": {
    "status": "active",
    "path": "/console",
    "auth": "OAuth authorization code + PKCE S256 + dynamic client registration",
    "defaultScopes": ["gameshop.read", "gameshop.plan", "gameshop.qa", "offline_access"],
    "elevatedScopes": ["gameshop.execute", "gameshop.write", "gameshop.deploy"],
    "policy": "The console is a first-party MCP client, not a separate orchestration implementation. It discovers and invokes the live MCP tool inventory; server-side Game Shop scope, spend, write, execution and deployment gates remain authoritative."
  },
  "gameWorkflowRouting": {
    "status": "active",
    "version": 1,
    "tools": [
      "gameshop_route_game_workflow",
      "gameshop_game_workflow_matrix"
    ],
    "runtimeLanes": ["browser", "unity", "cinematic", "hybrid"],
    "specialists": [
      "game-studio",
      "game-development-studio",
      "build-3d-game-rooms",
      "unity",
      "yoroll",
      "tripo-3d"
    ],
    "policy": "Use the smallest specialist set that satisfies the task. Preserve an existing engine unless requirements justify migration. Routing itself is read-only and never grants write, external-execution, paid-generation or deployment permission."
  },
  "websiteWorkflowRouting": {
    "status": "active",
    "version": 1,
    "tools": [
      "gameshop_route_website_workflow",
      "gameshop_website_workflow_matrix"
    ],
    "websiteKinds": ["landing", "marketing", "artist", "portfolio", "content", "ecommerce", "web-app", "experiential"],
    "policy": "Use the smallest stack that satisfies the website task. Existing sites should be inspected and repaired incrementally. Backend, commerce, 3D/shader and paid/external capabilities remain opt-in. Preview/browser evidence precedes production release. Routing itself is read-only."
  },
  "sdkHubPhase2": {
    "status": "active",
    "realOrchestration": true,
    "mcpExposed": true,
    "providers": [
      { "id": "replicate", "package": "replicate", "version": "^1.4.0", "env": ["REPLICATE_API_TOKEN"], "authStatus": "deferred-provider-auth-issue", "generation": true },
      { "id": "fal", "package": "@fal-ai/client", "version": "^1.10.1", "env": ["FAL_KEY"], "authStatus": "configured", "generation": true },
      { "id": "elevenlabs", "package": "@elevenlabs/elevenlabs-js", "version": "^2.68.0", "env": ["ELEVENLABS_API_KEY"], "authStatus": "ready", "generation": true },
      { "id": "scenario", "package": "@scenario-labs/sdk", "version": "^3.1.0", "env": ["SCENARIO_API_KEY", "SCENARIO_API_SECRET"], "authStatus": "sdk-installed-api-deferred", "generation": true },
      { "id": "cloudinary", "package": "cloudinary", "version": "^2.11.0", "env": ["CLOUDINARY_URL"], "authStatus": "configured", "generation": false }
    ],
    "tools": [
      "gameshop_sdk_hub_status",
      "gameshop_provider_health",
      "gameshop_real_orchestration_info",
      "gameshop_plan_provider_task",
      "gameshop_run_provider_task",
      "gameshop_continue_provider_task"
    ]
  },
  "notableStandaloneStatus": {
    "autosprite": "configured-local-and-vercel",
    "replicate": "adapter-ready-auth-deferred",
    "contextcore": "local-runtime-verify-per-machine",
    "kibo": "vendor-blocked-http-500",
    "spline": "local-app-required",
    "wangp": "local-runtime-deferred",
    "ludo": "auth-deferred",
    "scenarioApi": "auth-deferred"
  },
  "machineReadable": {
    "ecosystem": "ecosystem.json",
    "mcp": "mcp.json",
    "artifactSchema": "schemas/artifact.schema.json",
    "refresh": "npm run snapshot:ecosystem"
  },
  "handoff": {
    "bootstrap": "npm run bootstrap:universal",
    "verify": "npm run verify:standalone",
    "command": "npm run handoff:llm",
    "output": "dist/llm-handoff",
    "targetAgents": ["Grok", "Grokbot", "Claude", "Gemini", "Codex", "other MCP/coding agents"],
    "readOrder": [
      "AGENTS.md",
      "ecosystem.json",
      "mcp.json",
      "docs/GAME_WORKFLOW_ORCHESTRATION.md",
      "docs/WEBSITE_WORKFLOW_ORCHESTRATION.md",
      "docs/WEB_CONSOLE.md",
      "docs/STANDALONE_PORTABILITY.md",
      "docs/REAL_ORCHESTRATION.md",
      "llm-handoff/manifest.json",
      "llm-handoff/agent-config.json"
    ]
  }
}
