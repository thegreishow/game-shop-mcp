# Never commit real API keys. Copy this file to .env.local for local development.
SPRITESHIP_API_KEY=
AUTOSPRITE_API_KEY=
SPRITE_AI_API_KEY=
SPRITESHEET_AI_API_KEY=
SPRITECOOK_API_KEY=
AIMLAPI_API_KEY=
DEEPSEEK_API_KEY=

# Optional React Bits Pro license. Keep this private and use it only to let
# licensed agents install directly from the official React Bits registries.
REACTBITS_LICENSE_KEY=

# Gateway-level bearer token. Strongly recommended for every public deployment.
# Clients should send: Authorization: Bearer <GAME_SHOP_MCP_TOKEN>
GAME_SHOP_MCP_TOKEN=
