# Never commit real API keys. Copy this file to .env.local for local development.
SPRITESHIP_API_KEY=
AUTOSPRITE_API_KEY=
SPRITE_AI_API_KEY=
SPRITESHEET_AI_API_KEY=
SPRITECOOK_API_KEY=
AIMLAPI_API_KEY=
DEEPSEEK_API_KEY=

# Optional React Bits Pro license. Keep private; use only with official registries.
REACTBITS_LICENSE_KEY=

# Static gateway token for CLI/agent clients. Production fails closed if neither gateway nor OAuth is configured.
GAME_SHOP_MCP_TOKEN=
GAME_SHOP_RATE_LIMIT_PER_MINUTE=60
GAME_SHOP_PROVIDER_TIMEOUT_MS=12000
GAME_SHOP_PUBLIC_URL=https://game-shop-mcp.vercel.app

# OAuth 2.1 / PKCE for Grok.com and other web MCP clients.
GAME_SHOP_OAUTH_CLIENT_ID=game-shop-grok-web
GAME_SHOP_OAUTH_SIGNING_SECRET=
GAME_SHOP_OAUTH_OWNER_SECRET=
# Optional comma-separated HTTPS redirect hosts beyond grok.com and x.ai.
GAME_SHOP_OAUTH_REDIRECT_HOSTS=

# Live external MCP/API execution is independently locked. Leave unset until explicitly enabled.
# GAME_SHOP_ALLOW_EXTERNAL_INTEGRATIONS=true

# Credentials for registered remote integrations. Only configure services you actually use.
API_KEY_21ST=
MOTION_SO_API_KEY=
LUDO_API_KEY=
MESHY_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
SCENARIO_API_KEY=
MANUS_API_KEY=
PRELINE_API_KEY=
ORIGINKIT_API_KEY=
SHADERS_API_KEY=
UNISON_TOKEN=
PODIUM_API_KEY=
CLOUDINARY_URL=
DAISYUI_BLUEPRINT_LICENSE=
DAISYUI_BLUEPRINT_EMAIL=
BROWSERBASE_API_KEY=
GAME_SHOP_PLAYWRIGHT_MCP_URL=
GAME_SHOP_CHROME_DEVTOOLS_MCP_URL=

# Paid generation lock. Required in addition to external-integration opt-in for calls that may consume credits or money.
# GAME_SHOP_ALLOW_PAID_GENERATION=true

# GitHub project execution. GAME_SHOP_GITHUB_TOKEN is preferred; GITHUB_TOKEN remains supported for compatibility.
GAME_SHOP_GITHUB_TOKEN=
GITHUB_TOKEN=
# JSON array of registered products/projects. `projectPath` is preferred; legacy `gamePath` is still accepted.
# [{"id":"wata-dash","repo":"thegreishow/thegreishow.com","defaultBranch":"main","framework":"phaser","projectPath":"arcade/games/wata-dash"}]
GAME_SHOP_PROJECTS_JSON=[]
# GAME_SHOP_ALLOW_GITHUB_WRITES=true

# Durable execution, artifact and QA memory store. Never expose the service-role key client-side.
GAME_SHOP_SUPABASE_URL=
GAME_SHOP_SUPABASE_SERVICE_ROLE_KEY=
GAME_SHOP_ARTIFACT_BUCKET=game-shop-artifacts

# Optional preview deployment adapters.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GAME_SHOP_VERCEL_PROJECT_ID=
GAME_SHOP_VERCEL_DEPLOY_HOOK=
