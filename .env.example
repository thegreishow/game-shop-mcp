# Never commit real API keys. Copy this file to .env.local for local development.
SPRITESHIP_API_KEY=
AUTOSPRITE_API_KEY=
SPRITE_AI_API_KEY=
SPRITESHEET_AI_API_KEY=
SPRITECOOK_API_KEY=
AIMLAPI_API_KEY=
DEEPSEEK_API_KEY=

REACTBITS_LICENSE_KEY=
GAME_SHOP_MCP_TOKEN=
GAME_SHOP_RATE_LIMIT_PER_MINUTE=60
GAME_SHOP_RATE_LIMIT_READ_PER_MINUTE=120
GAME_SHOP_RATE_LIMIT_QA_PER_MINUTE=30
GAME_SHOP_RATE_LIMIT_EXECUTE_PER_MINUTE=30
GAME_SHOP_RATE_LIMIT_WRITE_PER_MINUTE=20
GAME_SHOP_RATE_LIMIT_DEPLOY_PER_MINUTE=10
GAME_SHOP_RATE_LIMIT_GENERATION_PER_MINUTE=10
GAME_SHOP_PROVIDER_TIMEOUT_MS=12000
GAME_SHOP_PUBLIC_URL=https://game-shop-mcp.vercel.app

# OAuth 2.1 / PKCE
GAME_SHOP_OAUTH_CLIENT_ID=game-shop-grok-web
GAME_SHOP_OAUTH_SIGNING_SECRET=
GAME_SHOP_OAUTH_OWNER_SECRET=
GAME_SHOP_OAUTH_REDIRECT_HOSTS=

# Keep legacy live external execution and paid generation locked until explicitly approved.
# The real Mission Control code runner instead requires OAuth Execute + Write and
# an explicit per-run spend confirmation, and only writes verified gameshop/* branches.
# GAME_SHOP_ALLOW_EXTERNAL_INTEGRATIONS=true
# GAME_SHOP_ALLOW_PAID_GENERATION=true

API_KEY_21ST=
MOTION_SO_API_KEY=
LUDO_API_KEY=
MESHY_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
SCENARIO_API_KEY=
SCENARIO_API_SECRET=
MANUS_API_KEY=
PRELINE_API_KEY=
ORIGINKIT_API_KEY=
SHADERS_API_KEY=
UNISON_TOKEN=
PODIUM_API_KEY=
CLOUDINARY_URL=
DAISYUI_BLUEPRINT_LICENSE=
DAISYUI_BLUEPRINT_EMAIL=
BROWSERBASE_API_KEY=
GAME_SHOP_PLAYWRIGHT_MCP_URL=
GAME_SHOP_CHROME_DEVTOOLS_MCP_URL=
GAME_SHOP_PLAYWRIGHT_CLI_ENABLED=false

# Optional web/game backend provider contracts. Keep secrets server-side.
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
CLERK_SECRET_KEY=
LOOTLOCKER_API_KEY=
IGDB_CLIENT_ID=
IGDB_ACCESS_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Real Mission Control code execution.
# On Vercel, VERCEL_OIDC_TOKEN is supplied by the platform and is preferred by
# the code runner through Vercel AI Gateway. AI_GATEWAY_API_KEY is an optional
# local/manual alternative; OPENAI_API_KEY remains a final fallback.
AI_GATEWAY_API_KEY=
GAME_SHOP_CODE_MODEL=openai/gpt-5.6-sol
# GAME_SHOP_DISABLE_REAL_MISSIONS=true

# GitHub project execution. Prefer the dedicated token.
GAME_SHOP_GITHUB_TOKEN=
GITHUB_TOKEN=
GAME_SHOP_PROJECTS_JSON=[]
# Legacy GitHub execution tools still use this flag; the real Mission runner is
# separately gated by OAuth Execute + Write and never writes the source branch.
# GAME_SHOP_ALLOW_GITHUB_WRITES=true

# Durable Game Shop state.
GAME_SHOP_SUPABASE_URL=
GAME_SHOP_SUPABASE_SERVICE_ROLE_KEY=
GAME_SHOP_ARTIFACT_BUCKET=game-shop-artifacts

# Same value must also exist as GitHub Actions secret GAME_SHOP_WORKER_SECRET.
GAME_SHOP_WORKER_SECRET=

# Preview adapters.
GAME_SHOP_VERCEL_PROJECTS_JSON={}
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GAME_SHOP_VERCEL_PROJECT_ID=
GAME_SHOP_VERCEL_DEPLOY_HOOK=