# Never commit real API keys. Copy this file to .env.local for local development.
SPRITESHIP_API_KEY=
AUTOSPRITE_API_KEY=
SPRITE_AI_API_KEY=
SPRITESHEET_AI_API_KEY=
SPRITECOOK_API_KEY=
AIMLAPI_API_KEY=
DEEPSEEK_API_KEY=

# Optional React Bits Pro license. Keep private; use only with official registries.
REACTBITS_LICENSE_KEY=

# REQUIRED in production. Production requests fail closed when this is missing.
GAME_SHOP_MCP_TOKEN=

# Gateway controls.
GAME_SHOP_RATE_LIMIT_PER_MINUTE=60
GAME_SHOP_PROVIDER_TIMEOUT_MS=12000

# Paid generation lock. Leave unset unless a human explicitly opts in.
# GAME_SHOP_ALLOW_PAID_GENERATION=true

# Optional GitHub project execution. Keep writes off until explicitly needed.
GITHUB_TOKEN=
# JSON array, for example:
# [{"id":"wata-dash","repo":"thegreishow/thegreishow.com","defaultBranch":"main","framework":"phaser","gamePath":"arcade/games/wata-dash"}]
GAME_SHOP_PROJECTS_JSON=[]
# GAME_SHOP_ALLOW_GITHUB_WRITES=true
